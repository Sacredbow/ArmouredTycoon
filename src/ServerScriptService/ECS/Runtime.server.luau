local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local ECS = require(ReplicatedStorage.ECS)
local Runner = require(ReplicatedStorage.ECS.Runner)

local DamageSystem = require(script.Parent.Systems.DamageSystem)
local EnvironmentClockSystem = require(script.Parent.Systems.EnvironmentClockSystem)
local LifetimeSystem = require(script.Parent.Systems.LifetimeSystem)
local NPCUpdateSystem = require(script.Parent.Systems.NPCUpdateSystem)
local ProductionTickSystem = require(script.Parent.Systems.ProductionTickSystem)
local RevealSystem = require(script.Parent.Systems.RevealSystem)
local RocketFlightSystem = require(script.Parent.Systems.RocketFlightSystem)
local ScheduledTaskSystem = require(script.Parent.Systems.ScheduledTaskSystem)
local StanceAnimationSystem = require(script.Parent.Systems.StanceAnimationSystem)
local TimedEmitterSystem = require(script.Parent.Systems.TimedEmitterSystem)
local TransformSyncSystem = require(script.Parent.Systems.TransformSyncSystem)
local WeaponRigSystem = require(script.Parent.Systems.WeaponRigSystem)

local runner = Runner.new("Server", ECS.world, ECS.Components)
runner:AddSystem("DamageSystem", DamageSystem)
runner:AddSystem("EnvironmentClockSystem", EnvironmentClockSystem)
runner:AddSystem("LifetimeSystem", LifetimeSystem)
runner:AddSystem("NPCUpdateSystem", NPCUpdateSystem)
runner:AddSystem("RevealSystem", RevealSystem)
runner:AddSystem("ProductionTickSystem", ProductionTickSystem)
runner:AddSystem("RocketFlightSystem", RocketFlightSystem)
runner:AddSystem("ScheduledTaskSystem", ScheduledTaskSystem)
runner:AddSystem("StanceAnimationSystem", StanceAnimationSystem)
runner:AddSystem("TimedEmitterSystem", TimedEmitterSystem)
runner:AddSystem("TransformSyncSystem", TransformSyncSystem)
runner:AddSystem("WeaponRigSystem", WeaponRigSystem)
runner:Start(RunService.Heartbeat)
