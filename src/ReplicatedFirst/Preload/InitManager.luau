local READY_TEXT = "Ready"

local COLORS = {
	Normal = Color3.fromRGB(220, 220, 220),
	Active = Color3.fromRGB(120, 200, 215),
	Final = Color3.fromRGB(255, 190, 120),
	Ready = Color3.fromRGB(120, 255, 150),
}

local function shuffle(array)
	for i = #array, 2, -1 do
		local j = math.random(i)
		array[i], array[j] = array[j], array[i]
	end
end

local function classify(text)
	if text == READY_TEXT then
		return "Ready"
	elseif string.find(text, "Final") or string.find(text, "Commit") or string.find(text, "Verify") then
		return "Final"
	else
		return "Active"
	end
end

function InitManager.new(config)
	local self = setmetatable({}, InitManager)

	self.Label = config.Label
	self.MinTime = config.MinTime or 0.05
	self.MaxTime = config.MaxTime or 1.8
	self.FadeTime = config.FadeTime or 0.15

	self._running = false
	self._finished = false

	self._steps = table.clone(STEPS)
	shuffle(self._steps)
	self._index = 1

	self._fadeInfo = TweenInfo.new(self.FadeTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

	return self
end

local function fade(label, info, transparency, color)
	local tween = TweenService:Create(label, info, {
		TextTransparency = transparency,
		TextColor3 = color,
	})
	tween:Play()
	return tween
end

function InitManager:Start()
	if self._running or not self.Label then
		return
	end
	self._running = true
	self._finished = false

	self.Label.TextTransparency = 0.3

	task.spawn(function()
		while self._running do
			if self._index > #self._steps then
				shuffle(self._steps)
				self._index = 1
			end

			local text = self._steps[self._index]
			local kind = classify(text)

			self.Label.Text = text
			fade(self.Label, self._fadeInfo, 0.3, COLORS[kind])

			task.wait(math.random() * (self.MaxTime - self.MinTime) + self.MinTime)

			fade(self.Label, self._fadeInfo, 1, COLORS[kind])
			self._index += 1
		end
	end)
end

function InitManager:Finish()
	if self._finished or not self.Label then
		return
	end
	self._finished = true
	self._running = false

	self.Label.Text = READY_TEXT
	self.Label.TextColor3 = COLORS.Ready
	self.Label.TextTransparency = 1

	TweenService
		:Create(
			self.Label,
			TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
			{ TextTransparency = 0 }
		)
		:Play()
end

function InitManager:Hide()
	if not self.Label then
		return
	end
	fade(self.Label, self._fadeInfo, 1, self.Label.TextColor3)
end

return InitManager
